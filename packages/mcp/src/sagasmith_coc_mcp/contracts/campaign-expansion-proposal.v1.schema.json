{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagasmith.ai/contracts/coc/campaign-expansion-proposal.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "purpose", "campaign_line_id", "title", "source_markdown", "generation_basis_refs", "claims", "unresolved", "requires_keeper_review", "decision_summary"],
  "properties": {
    "schema_version": {"const": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "purpose": {"const": "campaign_expansion"},
    "campaign_line_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "source_markdown": {"type": "string", "minLength": 1},
    "generation_basis_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "claims": {"type": "array"},
    "unresolved": {"type": "array", "items": {"type": "string"}},
    "requires_keeper_review": {"const": true},
    "decision_summary": {"type": "string"}
  }
}
